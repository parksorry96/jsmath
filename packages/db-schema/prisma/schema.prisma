generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "ocr"]
}

// ─── LMS 도메인 (lms schema) ───

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String       @map("password_hash")
  role           Role         @default(student)
  organizationId String?      @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  pushToken      String?      @map("push_token")
  enrollments    Enrollment[]
  parentLinks    ParentStudent[] @relation("ParentRelation")
  childLinks     ParentStudent[] @relation("StudentRelation")
  notifications  Notification[]
  submissions    Submission[]
  examDocuments  ExamDocument[]
  targetedAssignments Assignment[] @relation("TargetStudentAssignments")
  wrongAnswers    WrongAnswer[]    @relation("StudentWrongAnswers")
  masteries       StudentMastery[] @relation("StudentMasteries")
  reviewSchedules ReviewSchedule[] @relation("StudentReviews")
  diagnosticSessions DiagnosticSession[]
  tutorSessions      TutorSession[]
  xp              Int       @default(0)
  level           Int       @default(1)
  streaks         StudentStreak[]      @relation("StudentStreaks")
  achievements    StudentAchievement[] @relation("StudentAchievements")
  attendances     Attendance[]         @relation("StudentAttendances")
  billingRecords  BillingRecord[]      @relation("StudentBillings")
  ltiIdentities   LtiIdentity[]
  weaknessProfile  StudentWeaknessProfile?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("users")
  @@schema("public")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  classes   Class[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("organizations")
  @@schema("public")
}

model Class {
  id             String       @id @default(cuid())
  title          String
  description    String?
  organizationId String?      @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  enrollments    Enrollment[]
  assignments    Assignment[]
  lessons        Lesson[]
  attendances    Attendance[]
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("classes")
  @@schema("public")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  classId   String   @map("class_id")
  role      Role     @default(student)
  user      User     @relation(fields: [userId], references: [id])
  class     Class    @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, classId])
  @@map("enrollments")
  @@schema("public")
}

model Assignment {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  classId            String              @map("class_id")
  class              Class               @relation(fields: [classId], references: [id])
  type               AssignmentType      @default(text_task)
  dueAt              DateTime?           @map("due_at")
  maxScore           Int                 @default(100) @map("max_score")
  sourceAssignmentId String?             @map("source_assignment_id")
  examDocumentId     String?             @map("exam_document_id")
  examDocument       ExamDocument?       @relation(fields: [examDocumentId], references: [id])
  attachPdf          Boolean             @default(false) @map("attach_pdf")
  targetStudentId    String?             @map("target_student_id")
  targetStudent      User?               @relation("TargetStudentAssignments", fields: [targetStudentId], references: [id])
  assignmentProblems AssignmentProblem[]
  submissions        Submission[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([classId])
  @@index([targetStudentId])
  @@map("assignments")
  @@schema("public")
}

enum Role {
  admin
  teacher
  student
  parent

  @@schema("public")
}

// ─── New LMS Models ───

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String   @map("parent_id")
  studentId String   @map("student_id")
  parent    User     @relation("ParentRelation", fields: [parentId], references: [id])
  student   User     @relation("StudentRelation", fields: [studentId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([parentId, studentId])
  @@map("parent_students")
  @@schema("public")
}

model Lesson {
  id                 String       @id @default(cuid())
  classId            String       @map("class_id")
  class              Class        @relation(fields: [classId], references: [id])
  title              String
  startAt            DateTime     @map("start_at")
  endAt              DateTime     @map("end_at")
  recurrenceRule     String?      @map("recurrence_rule")
  recurrenceParentId String?      @map("recurrence_parent_id")
  recurrenceParent   Lesson?      @relation("RecurringLessons", fields: [recurrenceParentId], references: [id])
  recurrenceChildren Lesson[]     @relation("RecurringLessons")
  status             LessonStatus @default(scheduled)
  location           String?
  memo               String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([classId, startAt])
  @@index([recurrenceParentId])
  @@map("lessons")
  @@schema("public")
}

enum LessonStatus {
  scheduled
  completed
  cancelled

  @@schema("public")
}

enum AssignmentType {
  problem_set
  text_task
  remediation

  @@schema("public")
}

model AssignmentProblem {
  id           String     @id @default(cuid())
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  problemId    String     @map("problem_id")
  orderIndex   Int        @map("order_index")

  @@unique([assignmentId, problemId])
  @@index([assignmentId])
  @@map("assignment_problems")
  @@schema("public")
}

model ExamDocument {
  id              String               @id @default(cuid())
  title           String
  type            ExamDocumentType
  creatorId       String               @map("creator_id")
  creator         User                 @relation(fields: [creatorId], references: [id])
  visibility      ExamDocumentVisibility @default(private)
  headerConfig    Json?                @map("header_config")
  layoutConfig    Json                 @map("layout_config")
  coverConfig     Json?                @map("cover_config")
  pdfS3Key        String?              @map("pdf_s3_key")
  answerPdfS3Key  String?              @map("answer_pdf_s3_key")
  status          ExamDocumentStatus   @default(draft)
  errorMessage    String?              @map("error_message")
  blueprintId     String?              @map("blueprint_id")
  generationId    String?              @map("generation_id")
  problems        ExamDocumentProblem[]
  assignments     Assignment[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([creatorId])
  @@index([status])
  @@index([visibility])
  @@map("exam_documents")
  @@schema("public")
}

model ExamDocumentProblem {
  id             String       @id @default(cuid())
  examDocumentId String       @map("exam_document_id")
  examDocument   ExamDocument @relation(fields: [examDocumentId], references: [id], onDelete: Cascade)
  problemId      String       @map("problem_id")
  orderIndex     Int          @map("order_index")

  @@unique([examDocumentId, problemId])
  @@index([examDocumentId])
  @@map("exam_document_problems")
  @@schema("public")
}

enum ExamDocumentType {
  exam
  workbook

  @@schema("public")
}

enum ExamDocumentStatus {
  draft
  generating
  completed
  failed

  @@schema("public")
}

enum ExamDocumentVisibility {
  private
  public

  @@schema("public")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String           @map("assignment_id")
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  studentId    String           @map("student_id")
  student      User             @relation(fields: [studentId], references: [id])
  type         SubmissionType
  status       SubmissionStatus @default(submitted)
  score        Float?
  maxScore     Float?           @map("max_score")
  smartScore    Float?          @map("smart_score")
  smartScoreMeta Json?          @map("smart_score_meta")
  feedback     String?
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  gradedAt     DateTime?        @map("graded_at")
  gradedBy     String?          @map("graded_by")
  answers      SubmissionAnswer[]
  photos       SubmissionPhoto[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([assignmentId, studentId])
  @@index([assignmentId, studentId])
  @@index([studentId])
  @@map("submissions")
  @@schema("public")
}

enum SubmissionType {
  online
  photo

  @@schema("public")
}

enum SubmissionStatus {
  submitted
  grading
  graded
  returned

  @@schema("public")
}

model SubmissionAnswer {
  id            String     @id @default(cuid())
  submissionId  String     @map("submission_id")
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  problemId     String     @map("problem_id")
  studentAnswer String?    @map("student_answer")
  isCorrect     Boolean?   @map("is_correct")
  score         Float?
  feedback      String?
  rubricResult  Json?      @map("rubric_result")
  rubricScore   Float?     @map("rubric_score")
  rubricVersion Int?       @map("rubric_version")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@unique([submissionId, problemId])
  @@map("submission_answers")
  @@schema("public")
}

model SubmissionPhoto {
  id             String                @id @default(cuid())
  submissionId   String                @map("submission_id")
  submission     Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  s3Key          String                @map("s3_key")
  originalName   String?               @map("original_name")
  analysisStatus SubmissionPhotoStatus @default(pending) @map("analysis_status")
  aiFeedback     Json?                 @map("ai_feedback")
  analyzedAt     DateTime?             @map("analyzed_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([submissionId])
  @@map("submission_photos")
  @@schema("public")
}

enum SubmissionPhotoStatus {
  pending
  analyzing
  completed
  failed

  @@schema("public")
}

model Notification {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id])
  type          String
  title         String
  body          String
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
  @@schema("public")
}

// ─── Phase 2: Student Learning Models ───

model WrongAnswer {
  id               String          @id @default(cuid())
  studentId        String          @map("student_id")
  student          User            @relation("StudentWrongAnswers", fields: [studentId], references: [id])
  problemId        String          @map("problem_id")
  submissionId     String          @map("submission_id")
  errorType        ErrorType       @map("error_type")
  note             String?
  retryCount       Int             @default(0) @map("retry_count")
  lastRetryCorrect Boolean?        @map("last_retry_correct")
  resolvedAt       DateTime?       @map("resolved_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  reviewSchedule   ReviewSchedule?

  @@unique([studentId, problemId, submissionId])
  @@index([studentId, errorType])
  @@index([studentId, resolvedAt])
  @@map("wrong_answers")
  @@schema("public")
}

enum ErrorType {
  concept_gap
  pattern_gap
  calculation_error
  careless_mistake

  @@schema("public")
}

model StudentMastery {
  id                 String       @id @default(cuid())
  studentId          String       @map("student_id")
  student            User         @relation("StudentMasteries", fields: [studentId], references: [id])
  curriculumNodeId   String       @map("curriculum_node_id")
  state              MasteryState @default(not_started)
  consecutiveCorrect Int          @default(0) @map("consecutive_correct")
  totalAttempts      Int          @default(0) @map("total_attempts")
  totalCorrect       Int          @default(0) @map("total_correct")
  lastAttemptAt      DateTime?    @map("last_attempt_at")
  masteredAt         DateTime?    @map("mastered_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@unique([studentId, curriculumNodeId])
  @@index([studentId, state])
  @@map("student_masteries")
  @@schema("public")
}

model StudentWeaknessProfile {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])

  errorPatterns    Json
  rootCauses       Json

  aiSummary        String?
  aiSummaryModel   String?

  lastRecommendedAt DateTime?

  units     StudentWeaknessUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId])
  @@map("student_weakness_profiles")
  @@schema("public")
}

model StudentWeaknessUnit {
  id        String   @id @default(cuid())
  profileId String
  profile   StudentWeaknessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  subject      String
  unitMajor    String   @map("unit_major")
  accuracy     Float
  attemptCount Int      @map("attempt_count")
  topErrorType String?  @map("top_error_type")

  updatedAt DateTime @updatedAt

  @@unique([profileId, subject, unitMajor])
  @@index([subject, unitMajor])
  @@map("student_weakness_units")
  @@schema("public")
}

enum MasteryState {
  not_started
  learning
  practicing
  mastered

  @@schema("public")
}

model ReviewSchedule {
  id             String      @id @default(cuid())
  studentId      String      @map("student_id")
  student        User        @relation("StudentReviews", fields: [studentId], references: [id])
  wrongAnswerId  String      @unique @map("wrong_answer_id")
  wrongAnswer    WrongAnswer @relation(fields: [wrongAnswerId], references: [id], onDelete: Cascade)
  problemId      String      @map("problem_id")
  nextReviewAt   DateTime    @map("next_review_at")
  interval       Int         @default(1)
  easeFactor     Float       @default(2.5) @map("ease_factor")
  repetitions    Int         @default(0)
  lastReviewedAt DateTime?   @map("last_reviewed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([studentId, nextReviewAt])
  @@index([nextReviewAt])
  @@map("review_schedules")
  @@schema("public")
}

// ─── Phase 3: AI Enhancement Models ───

model DiagnosticSession {
  id              String               @id @default(cuid())
  studentId       String               @map("student_id")
  student         User                 @relation(fields: [studentId], references: [id])
  status          DiagnosticStatus     @default(in_progress)
  currentAbility  Json?                @map("current_ability")
  result          Json?
  startedAt       DateTime             @default(now()) @map("started_at")
  completedAt     DateTime?            @map("completed_at")
  responses       DiagnosticResponse[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([studentId])
  @@map("diagnostic_sessions")
  @@schema("public")
}

model DiagnosticResponse {
  id              String             @id @default(cuid())
  sessionId       String             @map("session_id")
  session         DiagnosticSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  problemId       String             @map("problem_id")
  studentAnswer   String?            @map("student_answer")
  isCorrect       Boolean?           @map("is_correct")
  responseTimeSec Int?               @map("response_time_sec")
  abilityBefore   Float?             @map("ability_before")
  abilityAfter    Float?             @map("ability_after")
  orderIndex      Int                @map("order_index")
  createdAt       DateTime           @default(now()) @map("created_at")

  @@unique([sessionId, problemId])
  @@index([sessionId])
  @@map("diagnostic_responses")
  @@schema("public")
}

enum DiagnosticStatus {
  in_progress
  completed
  abandoned

  @@schema("public")
}

model CurriculumPrerequisite {
  id          String   @id @default(cuid())
  fromSubject String   @map("from_subject")
  fromUnit    String   @map("from_unit")
  toSubject   String   @map("to_subject")
  toUnit      String   @map("to_unit")
  strength    Float    @default(1.0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([fromSubject, fromUnit, toSubject, toUnit])
  @@index([toSubject, toUnit])
  @@map("curriculum_prerequisites")
  @@schema("public")
}

model TutorSession {
  id          String         @id @default(cuid())
  studentId   String         @map("student_id")
  student     User           @relation(fields: [studentId], references: [id])
  problemId   String         @map("problem_id")
  status      TutorStatus    @default(active)
  messages    TutorMessage[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([problemId])
  @@map("tutor_sessions")
  @@schema("public")
}

model TutorMessage {
  id          String        @id @default(cuid())
  sessionId   String        @map("session_id")
  session     TutorSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        MessageRole
  content     String
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("tutor_messages")
  @@schema("public")
}

enum TutorStatus {
  active
  resolved
  abandoned

  @@schema("public")
}

enum MessageRole {
  student
  tutor

  @@schema("public")
}

// ─── Phase 4: Operations & Expansion Models ───

model ParentWeeklyReport {
  id                       String   @id @default(cuid())
  parentId                 String   @map("parent_id")
  studentId                String   @map("student_id")
  weekStart                DateTime @map("week_start")
  weekEnd                  DateTime @map("week_end")
  assignmentCompletionRate Float    @map("assignment_completion_rate")
  avgScore                 Float?   @map("avg_score")
  problemsSolved           Int      @map("problems_solved")
  correctRate              Float?   @map("correct_rate")
  lessonsAttended          Int      @map("lessons_attended")
  lessonsTotal             Int      @map("lessons_total")
  masteryProgress          Json?    @map("mastery_progress")
  weaknessHeatmap          Json?    @map("weakness_heatmap")
  scoreTrend               Json?    @map("score_trend")
  createdAt                DateTime @default(now()) @map("created_at")

  @@unique([parentId, studentId, weekStart])
  @@index([parentId, weekStart])
  @@index([studentId])
  @@map("parent_weekly_reports")
  @@schema("public")
}

model GradeCutoff {
  id          String   @id @default(cuid())
  examYear    Int      @map("exam_year")
  examMonth   Int      @map("exam_month")
  subject     String
  grade       Int
  minScore    Int      @map("min_score")
  maxScore    Int      @map("max_score")
  percentile  Float?
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([examYear, examMonth, subject, grade])
  @@index([examYear, examMonth, subject])
  @@map("grade_cutoffs")
  @@schema("public")
}

model StudentStreak {
  id              String    @id @default(cuid())
  studentId       String    @map("student_id")
  student         User      @relation("StudentStreaks", fields: [studentId], references: [id])
  streakType      String    @map("streak_type")
  currentStreak   Int       @default(0) @map("current_streak")
  longestStreak   Int       @default(0) @map("longest_streak")
  lastActivityAt  DateTime? @map("last_activity_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([studentId, streakType])
  @@map("student_streaks")
  @@schema("public")
}

model StudentAchievement {
  id             String   @id @default(cuid())
  studentId      String   @map("student_id")
  student        User     @relation("StudentAchievements", fields: [studentId], references: [id])
  achievementKey String   @map("achievement_key")
  metadata       Json?
  earnedAt       DateTime @default(now()) @map("earned_at")

  @@unique([studentId, achievementKey])
  @@index([studentId])
  @@map("student_achievements")
  @@schema("public")
}

model Attendance {
  id          String           @id @default(cuid())
  studentId   String           @map("student_id")
  student     User             @relation("StudentAttendances", fields: [studentId], references: [id])
  classId     String           @map("class_id")
  class       Class            @relation(fields: [classId], references: [id])
  date        DateTime
  status      AttendanceStatus @default(present)
  note        String?
  checkedInAt DateTime?        @map("checked_in_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@index([studentId, date])
  @@map("attendances")
  @@schema("public")
}

enum AttendanceStatus {
  present
  absent
  late
  excused

  @@schema("public")
}

model BillingRecord {
  id           String        @id @default(cuid())
  studentId    String        @map("student_id")
  student      User          @relation("StudentBillings", fields: [studentId], references: [id])
  classId      String?       @map("class_id")
  type         BillingType
  amount       Int
  description  String?
  billingMonth DateTime      @map("billing_month")
  status       BillingStatus @default(pending)
  paidAt       DateTime?     @map("paid_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([studentId, billingMonth])
  @@index([status])
  @@map("billing_records")
  @@schema("public")
}

enum BillingType {
  tuition
  material
  extra_class
  other

  @@schema("public")
}

enum BillingStatus {
  pending
  paid
  overdue
  cancelled

  @@schema("public")
}

model LtiPlatform {
  id            String   @id @default(cuid())
  name          String
  issuer        String   @unique
  clientId      String   @map("client_id")
  authEndpoint  String   @map("auth_endpoint")
  tokenEndpoint String   @map("token_endpoint")
  jwksUri       String   @map("jwks_uri")
  deploymentId  String?  @map("deployment_id")
  isActive      Boolean  @default(true) @map("is_active")
  identities    LtiIdentity[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("lti_platforms")
  @@schema("public")
}

model LtiIdentity {
  id         String      @id @default(cuid())
  platformId String      @map("platform_id")
  platform   LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  email      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@unique([platformId, subject])
  @@unique([platformId, userId])
  @@index([userId])
  @@map("lti_identities")
  @@schema("public")
}

// ─── OCR 도메인 (ocr schema — FastAPI/SQLAlchemy에서도 접근) ───

model SourceFile {
  id           String   @id @default(cuid())
  uploaderId   String?  @map("uploader_id")
  filename     String
  s3Key        String   @map("s3_key")
  answerS3Key  String?  @map("answer_s3_key")
  fileHash     String   @map("file_hash")
  sizeBytes    Int      @map("size_bytes")
  documentType String   @default("exam") @map("document_type")
  bookTitle    String?  @map("book_title")
  publisher    String?
  ocrJobs      OcrJob[]
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([uploaderId, fileHash])
  @@index([uploaderId])
  @@map("source_files")
  @@schema("ocr")
}

model OcrJob {
  id           String       @id @default(cuid())
  sourceFileId String       @map("source_file_id")
  sourceFile   SourceFile   @relation(fields: [sourceFileId], references: [id])
  status       OcrJobStatus @default(pending)
  autoAnalyze  Boolean      @default(true) @map("auto_analyze")
  documentType String       @default("exam") @map("document_type")
  bookTitle    String?      @map("book_title")
  publisher    String?
  problemCount Int?         @map("problem_count")
  errorMessage String?      @map("error_message")
  problems     Problem[]
  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")

  @@index([status, createdAt])
  @@map("ocr_jobs")
  @@schema("ocr")
}

enum OcrJobStatus {
  pending
  processing
  completed
  failed
  manual_review

  @@schema("ocr")
}

model Problem {
  id                       String        @id @default(cuid())
  ocrJobId                 String        @map("ocr_job_id")
  ocrJob                   OcrJob        @relation(fields: [ocrJobId], references: [id])
  textbookId               String?       @map("textbook_id")
  sourceFileId             String?       @map("source_file_id")

  // Position in source
  startPage                Int           @map("start_page")
  endPage                  Int           @map("end_page")
  problemNumber            String?       @map("problem_number")
  displayNumber            String?       @map("display_number")

  // Parent-child for sub-problems
  parentId                 String?       @map("parent_id")
  parent                   Problem?      @relation("SubProblems", fields: [parentId], references: [id])
  subProblems              Problem[]     @relation("SubProblems")

  // Content
  stemLatex                String        @map("stem_latex")
  stemText                 String        @map("stem_text")
  stemLatexNormalized      String?       @map("stem_latex_normalized")
  sharedStemLatex          String?       @map("shared_stem_latex")
  sharedStemText           String?       @map("shared_stem_text")
  problemType              ProblemType   @map("problem_type")
  bbox                     Json?

  // Answer
  answerText               String?       @map("answer_text")
  answerLatex              String?       @map("answer_latex")

  // Classification
  gradeLevel               String?       @map("grade_level")
  subject                  String?
  unitMajor                String?       @map("unit_major")
  unitMinor                String?       @map("unit_minor")
  unitSub                  String?       @map("unit_sub")
  curriculumNodeId         String?       @map("curriculum_node_id") @db.Uuid
  curriculumNode           CurriculumNode? @relation(fields: [curriculumNodeId], references: [id])
  classification2015       Json?         @map("classification_2015")
  classification2022       Json?         @map("classification_2022")
  difficulty               Int?          @db.SmallInt
  classificationConfidence Float?        @map("classification_confidence")
  solutionConfidence       Float?        @map("solution_confidence")
  reviewConfidence         Float?        @map("review_confidence")

  // Review
  reviewStatus             ReviewStatus  @default(pending_review) @map("review_status")
  reviewedBy               String?       @map("reviewed_by")
  flagReason               String?       @map("flag_reason")
  retiredAt                DateTime?     @map("retired_at")
  retiredBy                String?       @map("retired_by")

  // CSAT-specific
  isCommon             Boolean?      @map("is_common")
  pointValue           Int?          @db.SmallInt @map("point_value")
  questionFormat       String?       @map("question_format")
  positionType         String?       @map("position_type")
  examSource           Json?         @map("exam_source")

  // Textbook-specific
  bookSource           Json?         @map("book_source")
  answerMatchStatus    String?       @map("answer_match_status")
  solutionLatex        String?       @map("solution_latex")
  solutionText         String?       @map("solution_text")

  // AI analysis
  solutionTags         Json?         @map("solution_tags")
  solutionStrategy     String?       @map("solution_strategy")
  requiredConcepts     Json?         @map("required_concepts")
  solutionSteps        Json?         @map("solution_steps")
  alternativeSolutions Json?         @map("alternative_solutions")
  estimatedTimeSec     Int?          @map("estimated_time_sec")
  commonMistakes       Json?         @map("common_mistakes")
  difficultyRefined    Float?        @map("difficulty_refined")
  analysisStatus       String        @default("pending") @map("analysis_status")
  analyzedAt           DateTime?     @map("analyzed_at")
  stemTsv              Unsupported("tsvector")? @map("stem_tsv")
  embedding            Unsupported("vector(1536)")?

  // Relations
  choices                  ProblemChoice[]
  assets                   ProblemAsset[]

  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  @@index([ocrJobId])
  @@index([textbookId])
  @@index([gradeLevel, subject, unitMajor])
  @@index([curriculumNodeId])
  @@index([reviewStatus])
  @@index([analysisStatus])
  @@map("problems")
  @@schema("ocr")
}

model CurriculumNode {
  id              String           @id @default(uuid()) @db.Uuid
  curriculumYear  Int              @map("curriculum_year")
  level           Int              // 1=subject, 2=unitMajor, 3=unitMinor, 4=unitSub
  code            String           // machine-readable key e.g. "math1.polynomial.ops"
  label           String           // display name e.g. "다항식의 연산"
  parentId        String?          @map("parent_id") @db.Uuid
  parent          CurriculumNode?  @relation("CurriculumTree", fields: [parentId], references: [id])
  children        CurriculumNode[] @relation("CurriculumTree")
  sortOrder       Int              @default(0) @map("sort_order")
  gradeLevel      String?          @map("grade_level")
  createdAt       DateTime         @default(now()) @map("created_at")
  problems        Problem[]

  @@unique([curriculumYear, code])
  @@index([curriculumYear, level])
  @@index([parentId])
  @@map("curriculum_nodes")
  @@schema("ocr")
}

model ProblemChoice {
  id           String  @id @default(cuid())
  problemId    String  @map("problem_id")
  problem      Problem @relation(fields: [problemId], references: [id])
  position     Int     @db.SmallInt
  label        String  @db.VarChar(10)
  contentLatex String  @map("content_latex")
  contentText  String  @map("content_text")
  isCorrect    Boolean? @map("is_correct")

  @@unique([problemId, position])
  @@map("problem_choices")
  @@schema("ocr")
}

model ProblemAsset {
  id              String   @id @default(cuid())
  problemId       String   @map("problem_id")
  problem         Problem  @relation(fields: [problemId], references: [id])
  kind            String
  subKind         String?  @map("sub_kind")
  s3Key           String   @map("s3_key")
  format          String   @default("webp")
  widthPx         Int?     @map("width_px")
  heightPx        Int?     @map("height_px")
  detectionMethod String?  @map("detection_method")
  aiDescription   String?  @map("ai_description")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([problemId, kind])
  @@map("problem_assets")
  @@schema("ocr")
}

model ProblemSimilarity {
  id                String   @id @default(cuid())
  problemId         String   @map("problem_id")
  similarProblemId  String   @map("similar_problem_id")
  similarityScore   Float    @map("similarity_score")
  similarityType    String   @map("similarity_type")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([problemId, similarProblemId])
  @@index([problemId])
  @@map("problem_similarities")
  @@schema("ocr")
}

enum ProblemType {
  multiple_choice
  short_answer
  written_solution
  essay

  @@schema("ocr")
}

enum ReviewStatus {
  auto_approved
  pending_review
  approved
  rejected
  calibrated
  flagged
  retired

  @@schema("ocr")
}

enum RevisionChangeType {
  content_edit
  metadata_edit
  review_action
  ai_correction

  @@schema("ocr")
}

// ─── Phase 1.5: Quality & Stability Layer ───

model ProblemRevision {
  id             String             @id @default(cuid())
  problemId      String             @map("problem_id")
  revisionNumber Int                @map("revision_number")
  snapshot       Json
  changeType     RevisionChangeType @map("change_type")
  changedFields  String[]           @map("changed_fields")
  changeSummary  String?            @map("change_summary")
  changedById    String             @map("changed_by_id")
  changedByRole  String             @map("changed_by_role")
  changeSource   String             @default("manual") @map("change_source")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@unique([problemId, revisionNumber])
  @@index([problemId, revisionNumber])
  @@index([changedById])
  @@map("problem_revisions")
  @@schema("ocr")
}

model ProblemUsageLog {
  id            String           @id @default(cuid())
  problemId     String           @map("problem_id")
  usageType     ProblemUsageType @map("usage_type")
  referenceId   String           @map("reference_id")
  referenceType String           @map("reference_type")
  classId       String?          @map("class_id")
  targetCount   Int?             @map("target_count")
  usedAt        DateTime         @default(now()) @map("used_at")
  usedByUserId  String           @map("used_by_user_id")

  @@index([problemId, usedAt])
  @@index([problemId, classId])
  @@index([classId, usedAt])
  @@map("problem_usage_logs")
  @@schema("public")
}

enum ProblemUsageType {
  assignment
  exam_document
  diagnostic

  @@schema("public")
}

model ProblemStatistics {
  id                  String   @id @default(cuid())
  problemId           String   @unique @map("problem_id")
  periodStart         DateTime? @map("period_start")
  periodEnd           DateTime? @map("period_end")
  attemptCount        Int      @default(0) @map("attempt_count")
  correctCount        Int      @default(0) @map("correct_count")
  pValue              Float?   @map("p_value")
  avgScoreRatio       Float?   @map("avg_score_ratio")
  discriminationIndex Float?   @map("discrimination_index")
  pointBiserialR      Float?   @map("point_biserial_r")
  avgTimeSec          Float?   @map("avg_time_sec")
  medianTimeSec       Float?   @map("median_time_sec")
  isSufficientN       Boolean  @default(false) @map("is_sufficient_n")
  lastComputedAt      DateTime @map("last_computed_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([problemId])
  @@index([lastComputedAt])
  @@map("problem_statistics")
  @@schema("ocr")
}

model ChoiceStatistics {
  id             String   @id @default(cuid())
  problemId      String   @map("problem_id")
  choicePosition Int      @map("choice_position")
  selectCount    Int      @default(0) @map("select_count")
  selectRate     Float?   @map("select_rate")
  lastComputedAt DateTime @map("last_computed_at")

  @@unique([problemId, choicePosition])
  @@index([problemId])
  @@map("choice_statistics")
  @@schema("ocr")
}

model LearningEvent {
  id             String   @id @default(cuid())
  eventType      String   @map("event_type")
  studentId      String   @map("student_id")
  sessionId      String   @map("session_id")
  problemId      String?  @map("problem_id")
  assignmentId   String?  @map("assignment_id")
  organizationId String?  @map("organization_id")
  payload        Json     @default("{}")
  clientTs       DateTime @map("client_ts")
  serverTs       DateTime @default(now()) @map("server_ts")
  deviceType     String?  @map("device_type")
  appVersion     String?  @map("app_version")
  ipHash         String?  @map("ip_hash")

  @@index([studentId, serverTs])
  @@index([sessionId])
  @@index([eventType, serverTs])
  @@index([assignmentId, studentId])
  @@index([organizationId, serverTs])
  @@map("learning_events")
  @@schema("public")
}

model LearningEventDailyStat {
  id              String   @id @default(cuid())
  studentId       String   @map("student_id")
  statDate        DateTime @map("stat_date") @db.Date
  problemsViewed  Int      @default(0) @map("problems_viewed")
  problemsStarted Int      @default(0) @map("problems_started")
  problemsSolved  Int      @default(0) @map("problems_solved")
  problemsCorrect Int      @default(0) @map("problems_correct")
  hintsUsed       Int      @default(0) @map("hints_used")
  totalDurationMs BigInt   @default(0) @map("total_duration_ms")
  sessionCount    Int      @default(0) @map("session_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([studentId, statDate])
  @@index([studentId, statDate(sort: Desc)])
  @@map("learning_event_daily_stats")
  @@schema("public")
}

model ExamBlueprint {
  id                     String              @id @default(cuid())
  title                  String
  description            String?
  creatorId              String              @map("creator_id")
  gradeLevel             String?             @map("grade_level")
  totalQuestions          Int                 @map("total_questions")
  totalPoints            Int?                @map("total_points")
  timeLimitMin           Int?                @map("time_limit_min")
  unitDistribution       Json                @map("unit_distribution")
  difficultyDistribution Json                @map("difficulty_distribution")
  typeDistribution       Json                @map("type_distribution")
  pointDistribution      Json?               @map("point_distribution")
  excludeRecentDays      Int?                @map("exclude_recent_days")
  excludeProblemIds      Json?               @map("exclude_problem_ids")
  isTemplate             Boolean             @default(false) @map("is_template")
  generations            BlueprintGeneration[]
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@index([creatorId])
  @@map("exam_blueprints")
  @@schema("public")
}

model BlueprintGeneration {
  id           String        @id @default(cuid())
  blueprintId  String        @map("blueprint_id")
  blueprint    ExamBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  status       String        @default("pending")
  selectedIds  Json?         @map("selected_ids")
  matchScore   Float?        @map("match_score")
  relaxations  Json?
  errorMessage String?       @map("error_message")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([blueprintId])
  @@map("blueprint_generations")
  @@schema("public")
}

model PipelineCheckpoint {
  id           String    @id @default(cuid())
  ocrJobId     String    @map("ocr_job_id")
  stageName    String    @map("stage_name")
  status       String    @default("completed")
  payload      Json?
  errorMessage String?   @map("error_message")
  startedAt    DateTime  @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([ocrJobId, stageName])
  @@index([ocrJobId])
  @@map("pipeline_checkpoints")
  @@schema("ocr")
}
