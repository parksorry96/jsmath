# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jsmath

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (access token should be short-lived; use refresh tokens for long sessions)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# CORS (comma-separated origins allowed to access the API)
CORS_ORIGINS=http://localhost:3000

# OCR internal API (use a random 32+ byte token in production)
INTERNAL_API_TOKEN=change-me-internal
ENABLE_API_DOCS=false
ENABLE_LEGACY_PUBSUB=false
SINGLE_OCR_RATE_LIMIT_PER_MINUTE=20

# Mathpix
MATHPIX_APP_ID=your_mathpix_app_id
MATHPIX_APP_KEY=your_mathpix_app_key
MATHPIX_BASE_URL=https://api.mathpix.com/v3

# AI classifier (optional: if omitted, heuristic fallback runs)
AI_API_KEY=your_openai_api_key
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.4-mini
AI_TWIN_PROBLEM_MODEL=gpt-5.4
AI_TWIN_PROBLEM_VERIFY_MODEL=gpt-5.4

# Gemini document preprocess (PDF scan/split)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-pro

# S3 upload
S3_BUCKET=your_s3_bucket
S3_REGION=ap-northeast-2
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_SESSION_TOKEN=
S3_ENDPOINT_URL=
