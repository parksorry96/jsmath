\documentclass[10pt,a4paper]{article}
\usepackage{kotex}
\usepackage{amsmath,amssymb,amsfonts}
\usepackage{array}
\usepackage{enumitem}
\usepackage{fancyhdr}
\usepackage{geometry}
\usepackage{tcolorbox}
\usepackage{xcolor}
\tcbuselibrary{breakable}

\geometry{top=2cm, bottom=2cm, left=1.6cm, right=1.6cm}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

\definecolor{AnswerRule}{HTML}{6B7280}
\definecolor{AnswerBox}{HTML}{F8FAFC}
\definecolor{AnswerBorder}{HTML}{CBD5E1}

\newcommand{\choiceLabel}[1]{%
  \ifcase#1\or ①\or ②\or ③\or ④\or ⑤\or ⑥\or ⑦\or ⑧\or ⑨\or ⑩\else (#1)\fi
}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\bfseries <%- helpers.renderText(header.title || "수학 시험지") %> 해설지}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}

\fancypagestyle{firstpage}{
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

\begin{document}
\thispagestyle{firstpage}

\begin{center}
{\fontsize{18}{22}\selectfont\bfseries <%- helpers.renderText(header.title || "수학 시험지") %> 해설지\par}
\vspace{0.35cm}
\textcolor{AnswerRule}{\rule{\textwidth}{0.5pt}}
\end{center}
\vspace{0.7cm}

<% problems.forEach((p, idx) => { %>
<% const printableProblem = helpers.resolveProblemForPrint(p); %>
\begin{tcolorbox}[breakable, colback=AnswerBox, colframe=AnswerBorder, boxrule=0.5pt, arc=1.2mm, left=3mm, right=3mm, top=2mm, bottom=2mm]
\begin{minipage}[t]{0.08\linewidth}
\textbf{\large <%= idx + 1 %>.}
\end{minipage}
\begin{minipage}[t]{0.88\linewidth}
<%- helpers.renderLatexOrText(printableProblem.stemLatex, printableProblem.stemText) %>

<% if (printableProblem.choices.length > 0) { %>
\begin{list}{}{\setlength{\leftmargin}{2.15em}\setlength{\labelwidth}{1.35em}\setlength{\labelsep}{0.42em}\setlength{\itemsep}{0.12cm}\setlength{\topsep}{0.18cm}\setlength{\parsep}{0pt}}
<% printableProblem.choices.forEach((c) => { %>
\item[\choiceLabel{<%= c.position %>}] <%- helpers.renderChoiceLatexOrText(c.contentLatex, c.contentText) %>
<% }); %>
\end{list}
<% } %>

\vspace{0.2cm}
{\small\textbf{정답}}\quad
<% if (p.answerText || p.answerLatex) { %>
<%- helpers.renderInlineLatexOrText(p.answerLatex, p.answerText) %>
<% } else { %>
미입력
<% } %>

<% if (p.solutionSteps && Array.isArray(p.solutionSteps) && p.solutionSteps.length > 0) { %>
\vspace{0.3cm}
{\small\textbf{풀이}}\par
\begin{enumerate}[leftmargin=1.8em, itemsep=0.1cm, topsep=0.12cm]
<% p.solutionSteps.forEach((step) => { const renderedStep = helpers.renderSolutionStep(step); if (renderedStep) { %>
\item <%- renderedStep %>
<% } }); %>
\end{enumerate}
<% } else if (p.solutionLatex || p.solutionText) { %>
\vspace{0.3cm}
{\small\textbf{풀이}}\par
<%- helpers.renderInlineLatexOrText(p.solutionLatex, p.solutionText) %>
<% } %>

<% if (p.solutionStrategy) { %>
\vspace{0.25cm}
{\small\textit{풀이 전략}}\par
{\small <%- helpers.renderNarrativeLatexOrText(p.solutionStrategy) %>}
<% } %>
\end{minipage}
\end{tcolorbox}
\vspace{0.35cm}
<% }); %>

\end{document}
